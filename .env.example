# Local MongoDB Community Server (works with MongoDB Compass connected to the same server)
MONGODB_URI=mongodb://127.0.0.1:27017/attendease
MONGODB_DB=attendease

# For MongoDB Atlas instead, replace MONGODB_URI with your Atlas connection string:
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/attendease?retryWrites=true&w=majority

# Used only when creating the first administrator in an empty database.
# Existing users are never overwritten by the seed script.
DEFAULT_ADMIN_PASSWORD=admin123
